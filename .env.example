# =============================================================================
# UniSync — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
#
#   cp .env.example .env.local
#
# Anything prefixed with NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore PUBLIC. Never give a NEXT_PUBLIC_ name to a secret.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Absolute base URL of this deployment. Used for auth redirects and callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Supabase — Auth, Storage
# -----------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Data API
# Safe to expose to the browser: protected by Row Level Security.
#
# Supabase's own snippets now call this NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# It is the same value; we keep the ANON_KEY name because `lib/env.ts` and every
# client helper already spell it that way, and Next.js only inlines
# NEXT_PUBLIC_* names that appear literally in source.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"

# SECRET. Bypasses Row Level Security entirely — server-side only.
# Optional: leave blank unless a server task genuinely needs admin privileges.
SUPABASE_SERVICE_ROLE_KEY=""

# -----------------------------------------------------------------------------
# Database — PostgreSQL (Supabase), consumed by Prisma
# -----------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Database → Connection string
#
# Note the two URLs use DIFFERENT hosts and DIFFERENT usernames:
#
# DATABASE_URL  : pooled connection (Supavisor, port 6543), used at runtime.
#                 Host `aws-0-<region>.pooler.supabase.com`, user
#                 `postgres.<project-ref>`. Must carry
#                 `?pgbouncer=true&connection_limit=1` for serverless.
# DIRECT_URL    : direct connection (port 5432), used by Prisma Migrate only.
#                 Host `db.<project-ref>.supabase.co`, user `postgres`.
#
# If the password contains characters outside [A-Za-z0-9._~-], percent-encode it.
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres"

# -----------------------------------------------------------------------------
# AI — Google Gemini
# -----------------------------------------------------------------------------
# SECRET. Server-side only; never referenced from a Client Component.
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Default model used by the AI administrative agent.
GEMINI_MODEL="gemini-3.6-flash"
